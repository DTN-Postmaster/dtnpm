[Unit]
Description=Hamradio DTN BPv7 Bundle Processing Node
Documentation=https://github.com/loic-fejoz/dtn-hdy-utils
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dtnpm
Group=dtnpm
WorkingDirectory=/var/lib/dtn-hdy-ham
StateDirectory=dtn-hdy-ham
ConfigurationDirectory=dtn-hdy-ham
ExecStart=/usr/local/bin/dtn-hdy-ham -c /etc/dtn-hdy-ham/config.toml
Restart=on-failure
RestartSec=5s

# Security hardening options
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=true
LockPersonality=true

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
